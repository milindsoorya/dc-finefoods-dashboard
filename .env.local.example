# ============================================
# Supabase Connection
# Get these from: Supabase Dashboard → Settings → API
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-key-here

# ============================================
# Environment (used to show environment badge)
# Set to "production" on your live Vercel deployment
# Set to "development" for local dev and preview deployments
# ============================================
NEXT_PUBLIC_APP_ENV=development
